<h2>Sales</h2>

<h3>Add New Sale</h3>

<form action="/sales/create" method="POST">
    <div>
        <label for="customerID">Customer ID</label>
        <input type="number" id="customerID" name="customerID" required>
    </div>

    <div>
        <label for="invoiceAmount">Invoice Amount</label>
        <input type="number" id="invoiceAmount" name="invoiceAmount" step="0.01" required>
    </div>

    <div>
        <label for="paymentType">Payment Type</label>
        <select id="paymentType" name="paymentType" required>
            <option value="Visa">Visa</option>
            <option value="MasterCard">MasterCard</option>
            <option value="Cash">Cash</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div>
        <label for="status">Status</label>
        <select id="status" name="status" required>
            <option value="pending">Pending</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
        </select>
    </div>

    <div>
        <label for="invoiceDate">Invoice Date</label>
        <input type="datetime-local" id="invoiceDate" name="invoiceDate" required>
    </div>

    <button type="submit">Create Sale</button>
</form>


<hr>

<h3>Sales List</h3>
<table>
    <thead>
        <tr>
            <th>Sales ID</th>
            <th>Customer Name</th>
            <th>Invoice Date</th>
            <th>Invoice Amount</th>
            <th>Payment Type</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {{#each sales}}
            <tr>
                <td>{{salesID}}</td>
                <td>{{customerName}}</td>
                <td>{{invoiceDate}}</td>
                <td>${{invoiceAmount}}</td>
                <td>{{paymentType}}</td>
                <td>{{status}}</td>
                <td>
                    <a href="/inventory/edit/{{inventoryID}}">Edit</a>
                    <form action="/sales/delete" method="POST">
                        <input type="hidden" name="salesID" value="{{salesID}}">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        {{/each}}
    </tbody>
</table>




