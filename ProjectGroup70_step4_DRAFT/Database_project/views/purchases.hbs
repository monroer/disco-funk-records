<h1>Purchases</h1>

<h2>Add Purchase</h2>

<form action="/purchases" method="POST">

    <label>Supplier Name:</label>
    <input type="text" name="supplierName" placeholder="Type supplier name" required>

    <label>Purchase Date:</label>
    <input type="datetime-local" name="purchaseDate" required>

    <label>Total Cost:</label>
    <input type="number" step="0.01" name="totalCost" required>

    <label>Status:</label>
    <select name="status" required>
        <option value="pending">Pending</option>
        <option value="completed">Completed</option>
        <option value="cancelled">Cancelled</option>
    </select>

    <button type="submit">Add Purchase</button>
</form>

<hr>

<h3>Existing purchases</h3>
<table>
    <thead>
        <tr>
            <th>Purchase ID</th>
            <th>Supplier ID</th>
            <th>Purchase Date</th>
            <th>Total Cost</th>
            <th>Status</th>
            <th>actions</th>
        </tr>
    </thead>
    <tbody>
        {{#each purchases}}
            <tr>
                <td>{{purchaseID}}</td>
                <td>{{supplierID}}</td>
                <td>{{purchaseDate}}</td>
                <td>{{totalCost}}</td>
                <td>{{status}}</td>
                <td>
                    <a href="/inventory/edit/{{inventoryID}}">Edit</a>
                    <form action="/inventory/delete" method="POST" style="display:inline;">
                        <input type="hidden" name="inventoryID" value="{{inventoryID}}">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>

        {{/each}}
    </tbody>
</table>

